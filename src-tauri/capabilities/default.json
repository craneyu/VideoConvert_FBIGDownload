{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "clipboard-manager:default",
    "allow-app-commands",
    "opener:default",
    "dialog:default",
    "notification:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "updater:default",
    "fs:default",
    "fs:allow-home-read",
    "fs:allow-home-write"
  ]
}
